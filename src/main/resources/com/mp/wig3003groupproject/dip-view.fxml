<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.image.*?>

<VBox spacing="15" prefWidth="320"
      style="-fx-background-color: #FFFFFF; -fx-border-color: #D0E8FF; -fx-border-width: 0 0 0 1; -fx-padding: 20; -fx-background-radius: 40 0 0 40; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mp.wig3003groupproject.DIPController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="🎨 Image Lab" style="-fx-font-size: 22; -fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Reset" onAction="#handleResetAll"
                style="-fx-background-color: #9DCCFF; -fx-text-fill: #4A4A4A; -fx-background-radius: 10; -fx-font-size: 11; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-border-color: #E5E0F8; -fx-border-radius: 10; -fx-cursor: hand;"/>
    </HBox>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox spacing="20">

            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #D9C8FF; -fx-border-radius: 15;">
                <Label text="ADJUSTMENTS" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Exposure" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/><Label fx:id="brightnessLabel" text="0%" style="-fx-text-fill: #7A7A7A;"/>
                    </HBox>
                    <Slider fx:id="brightnessSlider" min="-1.0" max="1.0" value="0"/>
                </VBox>
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Contrast" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/><Label fx:id="contrastLabel" text="0%" style="-fx-text-fill: #7A7A7A;"/>
                    </HBox>
                    <Slider fx:id="contrastSlider" min="-1.0" max="1.0" value="0"/>
                </VBox>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #C8E8FF; -fx-border-radius: 15;">
                <Label text="TRANSFORM" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button text="🔄 Rotate 90°" onAction="#handleRotate" maxWidth="Infinity" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <HBox spacing="5" alignment="CENTER">
                    <TextField fx:id="widthField" prefWidth="70" promptText="W"/>
                    <Label text="×"/>
                    <TextField fx:id="heightField" prefWidth="70" promptText="H"/>
                    <Button text="Go" onAction="#handleResize" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-weight: bold; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 5; -fx-cursor: hand;"/>
                </HBox>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #FFE8C8; -fx-border-radius: 15;">
                <Label text="DECORATION" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button fx:id="borderToggleBtn" text="Enable Border" onAction="#handleBorderToggle" maxWidth="Infinity" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>

                <VBox fx:id="borderControlsBox" spacing="12" disable="true" opacity="0.4">
                    <HBox spacing="8" alignment="BOTTOM_LEFT">
                        <VBox spacing="5" prefWidth="130">
                            <Label text="Color" style="-fx-font-size: 11; -fx-text-fill: #4A4A4A;"/>
                            <ColorPicker fx:id="customColorPicker" style="-fx-background-radius: 5;" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="5" prefWidth="130">
                            <Label text="Pattern" style="-fx-font-size: 11; -fx-text-fill: #4A4A4A;"/>
                            <ComboBox fx:id="patternCombo" maxWidth="Infinity" style="-fx-background-radius: 5;">
                                <items>
                                    <FXCollections fx:factory="observableArrayList">
                                        <String fx:value="Solid" />
                                        <String fx:value="Gradient" />
                                        <String fx:value="Stripes" />
                                        <String fx:value="Polka Dots" />
                                    </FXCollections>
                                </items>
                                <value><String fx:value="Solid"/></value>
                            </ComboBox>
                        </VBox>
                    </HBox>

                    <VBox spacing="3">
                        <Label text="Thickness" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold; -fx-font-size: 12;"/>
                        <Slider fx:id="borderThicknessSlider" min="1" max="100" value="25"/>
                    </VBox>
                    <VBox spacing="3">
                        <Label text="Roundness" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold; -fx-font-size: 12;"/>
                        <Slider fx:id="borderRoundSlider" min="0" max="250" value="0"/>
                    </VBox>
                </VBox>
            </VBox>

            <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #C8F0DC; -fx-border-radius: 15;">
                <Label text="FILTERS" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button fx:id="grayscaleBtn" text="Apply Grayscale" onAction="#handleGrayscale" maxWidth="Infinity" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-weight: bold; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-cursor: hand;"/>
                <ToggleButton fx:id="selectionToggle" text="Magic Wand" maxWidth="Infinity" style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-weight: bold; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-cursor: hand;"/>
            </VBox>

            <VBox fx:id="downloadContainer" visible="false" spacing="12" style="-fx-padding: 0 0 30 0;">
                <VBox spacing="10">
                    <Label text="SAVE &amp; DISTRIBUTION" style="-fx-font-family: 'Poppins SemiBold'; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                    
                    <Button text="📥 Save to Gallery Only" onAction="#handleSaveToGallery" maxWidth="Infinity" minHeight="50"
                            style="-fx-background-color: #4F5BD5; -fx-text-fill: #FFFFFF; -fx-background-radius: 12; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(79,91,213,0.3), 10, 0, 0, 4);"/>

                    <Button onAction="#handleShareWhatsApp" maxWidth="Infinity" minHeight="50"
                            style="-fx-background-color: #25D366; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Poppins Medium'; -fx-font-weight: bold;">
                        <graphic>
                            <HBox spacing="10" alignment="CENTER">
                                <javafx.scene.shape.SVGPath content="M13.601 2.326A7.85 7.85 0 0 0 7.994 0C3.627 0 .068 3.558.064 7.926c0 1.399.366 2.76 1.057 3.965L0 16l4.204-1.102a7.9 7.9 0 0 0 3.79.965h.004c4.368 0 7.926-3.558 7.93-7.93A7.9 7.9 0 0 0 13.6 2.326zM7.994 14.521a6.6 6.6 0 0 1-3.356-.92l-.24-.144-2.494.654.666-2.433-.156-.251a6.56 6.56 0 0 1-1.007-3.505c0-3.626 2.957-6.584 6.591-6.584a6.56 6.56 0 0 1 4.66 1.931 6.56 6.56 0 0 1 1.928 4.66c-.004 3.639-2.961 6.592-6.592 6.592m3.615-4.934c-.197-.099-1.17-.578-1.353-.646-.182-.065-.315-.099-.445.099-.133.197-.513.646-.627.775-.114.133-.232.148-.43.05-.197-.1-.836-.308-1.592-.985-.59-.525-.985-1.175-1.103-1.372-.114-.198-.011-.304.088-.403.087-.088.197-.232.296-.346.1-.114.133-.198.198-.33.065-.134.034-.248-.015-.347-.05-.099-.445-1.076-.612-1.47-.16-.389-.323-.335-.445-.34-.114-.007-.247-.007-.38-.007a.73.73 0 0 0-.529.247c-.182.198-.691.677-.691 1.654s.71 1.916.81 2.049c.098.133 1.394 2.132 3.383 2.992.47.205.84.326 1.129.418.475.152.904.129 1.246.08.38-.058 1.171-.48 1.338-.943.164-.464.164-.86.114-.943-.049-.084-.182-.133-.38-.232" 
                                                        fill="WHITE" scaleX="1.2" scaleY="1.2"/>
                                <Label text="Save &amp; Share on WhatsApp" style="-fx-text-fill: white;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button onAction="#handleShareEmail" maxWidth="Infinity" minHeight="50"
                            style="-fx-background-color: #2196F3; -fx-text-fill: white; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Poppins Medium'; -fx-font-weight: bold;">
                        <graphic>
                            <HBox spacing="10" alignment="CENTER">
                                <javafx.scene.shape.SVGPath content="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z" 
                                                        fill="WHITE" scaleX="1.2" scaleY="1.2"/>
                                <Label text="Save &amp; Share via Email" style="-fx-text-fill: white;"/>
                            </HBox>
                        </graphic>
                    </Button>

                    <Button text="💾 Export as Manual File" onAction="#handleSaveAction" maxWidth="Infinity" minHeight="40"
                            style="-fx-background-color: transparent; -fx-text-fill: #4F5BD5; -fx-background-radius: 12; -fx-border-color: #EEF2FF; -fx-border-radius: 12; -fx-font-family: 'Poppins Medium'; -fx-font-size: 11; -fx-cursor: hand;"/>
                </VBox>
            </VBox>
        </VBox>
    </ScrollPane>
</VBox>