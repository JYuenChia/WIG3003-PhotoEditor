<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.image.*?>

<VBox spacing="15" prefWidth="320"
      style="-fx-background-color: #FFFFFF; -fx-border-color: #D0E8FF; -fx-border-width: 0 0 0 1; -fx-padding: 20; -fx-background-radius: 40 0 0 40; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mp.wig3003groupproject.MosaicController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="▦ Image Mosaic" style="-fx-font-size: 22; -fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Reset" onAction="#handleReset"
                style="-fx-background-color: #9DCCFF; -fx-text-fill: #4A4A4A; -fx-background-radius: 10; -fx-font-size: 11; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-border-color: #E5E0F8; -fx-border-radius: 10; -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="statusLabel" text="Load an image and tiles to start" 
            style="-fx-text-fill: #8892B0; -fx-font-size: 12; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif; -fx-wrap-text: true;"/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox spacing="20">

            <!-- IMAGE & TILES LOADING SECTION -->
            <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #D9C8FF; -fx-border-radius: 15;">
                <Label text="LOAD IMAGES" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button fx:id="loadImageBtn" text="📁 Load Base Image" onAction="#handleLoadImage" maxWidth="Infinity" 
                        style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
                <Button fx:id="loadTilesBtn" text="🎨 Load Tile Library" onAction="#handleLoadTiles" maxWidth="Infinity" 
                        style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <!-- TILE SIZE SECTION -->
            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #E8D0FF; -fx-border-radius: 15;">
                <Label text="TILE DIMENSIONS" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Tile Width" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/><Label fx:id="tileWidthLabel" text="32 px" style="-fx-text-fill: #7A7A7A;"/>
                    </HBox>
                    <Slider fx:id="tileWidthSlider" min="8" max="128" value="32"/>
                </VBox>

                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Tile Height" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/><Label fx:id="tileHeightLabel" text="32 px" style="-fx-text-fill: #7A7A7A;"/>
                    </HBox>
                    <Slider fx:id="tileHeightSlider" min="8" max="128" value="32"/>
                </VBox>
            </VBox>

            <!-- BLENDING SECTION -->
            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #C8F0DC; -fx-border-radius: 15;">
                <Label text="BLENDING" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Tile Blending" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/><Label fx:id="blendingLabel" text="50%" style="-fx-text-fill: #7A7A7A;"/>
                    </HBox>
                    <Slider fx:id="blendingSlider" min="0.0" max="1.0" value="0.5"/>
                </VBox>
                <Label text="Higher values = more tile colors, lower = more original image colors" 
                        style="-fx-text-fill: #8892B0; -fx-font-size: 11; -fx-font-style: italic; -fx-wrap-text: true;"/>
            </VBox>

            <!-- GENERATION SECTION -->
            <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #FFE8C8; -fx-border-radius: 15;">
                <Label text="GENERATION" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button fx:id="generateBtn" text="✨ Generate Mosaic" onAction="#handleGenerateMosaic" maxWidth="Infinity" 
                        style="-fx-background-color: #4F5BD5; -fx-text-fill: white; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <!-- DOWNLOAD SECTION -->
            <VBox fx:id="downloadContainer" spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #A6E3A1; -fx-border-radius: 15;">
                <Label text="SAVE MOSAIC" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button fx:id="downloadBtn" text="💾 Save Mosaic" onAction="#handleDownloadMosaic" maxWidth="Infinity" 
                        style="-fx-background-color: #A6E3A1; -fx-text-fill: #237C3A; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
