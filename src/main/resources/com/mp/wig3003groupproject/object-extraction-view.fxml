<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<?import javafx.scene.image.*?>

<VBox spacing="15" prefWidth="320"
      style="-fx-background-color: #FFFFFF; -fx-border-color: #D0E8FF; -fx-border-width: 0 0 0 1; -fx-padding: 20; -fx-background-radius: 40 0 0 40; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif;"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mp.wig3003groupproject.ObjectExtractionController">

    <HBox alignment="CENTER_LEFT" spacing="10">
        <Label text="◧ Object Extraction" style="-fx-font-size: 22; -fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
        <Region HBox.hgrow="ALWAYS" />
        <Button text="Reset" onAction="#handleReset"
                style="-fx-background-color: #9DCCFF; -fx-text-fill: #4A4A4A; -fx-background-radius: 10; -fx-font-size: 11; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-border-color: #E5E0F8; -fx-border-radius: 10; -fx-cursor: hand;"/>
    </HBox>

    <Label fx:id="statusLabel" text="Load an image to start" 
            style="-fx-text-fill: #8892B0; -fx-font-size: 12; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif; -fx-wrap-text: true;"/>

    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
        <VBox spacing="20">

            <!-- IMAGE LOADING SECTION -->
            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #D9C8FF; -fx-border-radius: 15;">
                <Label text="IMAGE LOADING" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button fx:id="loadImageBtn" text="📁 Load Image" onAction="#handleLoadImage" maxWidth="Infinity" 
                        style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <!-- COLOR TOLERANCE SECTION -->
            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #E8D0FF; -fx-border-radius: 15;">
                <Label text="COLOR SELECTION" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Color Tolerance" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/><Label fx:id="toleranceLabel" text="10%" style="-fx-text-fill: #7A7A7A;"/>
                    </HBox>
                    <Slider fx:id="colorToleranceSlider" min="0.01" max="0.5" value="0.1"/>
                </VBox>
                <Label text="Click on an object in the image to select its color." 
                        style="-fx-text-fill: #8892B0; -fx-font-size: 11; -fx-font-style: italic; -fx-wrap-text: true;"/>
            </VBox>

            <!-- OUTPUT SECTION -->
            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #C8F0DC; -fx-border-radius: 15;">
                <Label text="OUTPUT MODE" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <ComboBox fx:id="outputModeCombo" maxWidth="Infinity" 
                         style="-fx-background-radius: 5; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif;"/>
            </VBox>

            <!-- EXTRACTION CONTROLS SECTION -->
            <VBox spacing="12" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #FFE8C8; -fx-border-radius: 15;">
                <Label text="TRANSPARENCY" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <VBox spacing="5">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Alpha Opacity" style="-fx-text-fill: #4A4A4A; -fx-font-weight: bold;"/>
                        <Region HBox.hgrow="ALWAYS"/><Label fx:id="alphaLabel" text="100%" style="-fx-text-fill: #7A7A7A;"/>
                    </HBox>
                    <Slider fx:id="alphaSlider" min="0.0" max="1.0" value="1.0"/>
                </VBox>
            </VBox>

            <!-- ACTION BUTTONS SECTION -->
            <VBox spacing="10" style="-fx-background-color: #FFFFFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #D8DEFF; -fx-border-radius: 15;">
                <Label text="EXTRACTION" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                <Button fx:id="extractBtn" text="✨ Extract Object" onAction="#handleExtract" maxWidth="Infinity" 
                        style="-fx-background-color: #4F5BD5; -fx-text-fill: white; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-background-radius: 10; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>

            <!-- DOWNLOAD SECTION -->
            <VBox fx:id="downloadContainer" visible="false" spacing="12" style="-fx-padding: 0 0 30 0;">
                <VBox spacing="10">
                    <Label text="SAVE &amp; DISTRIBUTION" style="-fx-font-family: 'Poppins SemiBold'; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                    
                    <Button text="📥 Save to Gallery Only" onAction="#handleSaveToGallery" maxWidth="Infinity" minHeight="50"
                            style="-fx-background-color: #4F5BD5; -fx-text-fill: #FFFFFF; -fx-background-radius: 12; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-cursor: hand; -fx-effect: dropshadow(gaussian, rgba(79,91,213,0.3), 10, 0, 0, 4);"/>

                    <Button text="💾 Save to Local" onAction="#handleSaveAction" maxWidth="Infinity" minHeight="50"
                            style="-fx-background-color: #EEF2FF; -fx-text-fill: #4F5BD5; -fx-background-radius: 12; -fx-cursor: hand; -fx-font-family: 'Poppins Medium'; -fx-font-weight: bold; -fx-border-color: #D8DEFF; -fx-border-radius: 12;"/>
                </VBox>
            </VBox>

        </VBox>
    </ScrollPane>
</VBox>
