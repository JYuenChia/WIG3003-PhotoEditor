<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.collections.FXCollections?>
<?import java.lang.String?>

<HBox xmlns:fx="http://javafx.com/fxml"
      fx:id="videoCreatorPane"
      fx:controller="com.mp.wig3003groupproject.VideoController"
      style="-fx-background-color: #F7F8FA;">
    
    <!-- Center Workspace (Left) -->
    <StackPane HBox.hgrow="ALWAYS" style="-fx-padding: 15;">
        <VBox fx:id="videoDropZone" alignment="CENTER" spacing="25" 
              style="-fx-background-color: #FFFFFF; -fx-background-radius: 20; -fx-border-color: #D8DEFF; -fx-border-width: 2; -fx-border-style: dashed; -fx-border-radius: 20;">
            <Label text="⏵" style="-fx-font-size: 56; -fx-text-fill: #4F5BD5; -fx-padding: 0 0 0 5;"/>
            <VBox alignment="CENTER" spacing="5">
                <Label text="Master Your Media" style="-fx-font-size: 20; -fx-font-weight: bold; -fx-text-fill: #1A1D2E;"/>
                <Label text="Choose an entry point to begin creating" style="-fx-font-size: 13; -fx-text-fill: #8892B0;"/>
            </VBox>
            
            <HBox spacing="20" alignment="CENTER">
                <Button onAction="#handleUploadVideo" 
                        style="-fx-background-color: #FFFFFF; -fx-text-fill: #4F5BD5; -fx-border-color: #4F5BD5; -fx-border-radius: 15; -fx-background-radius: 15; -fx-padding: 15 25; -fx-font-weight: bold; -fx-cursor: hand;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="🎬" style="-fx-font-size: 24;"/>
                            <Label text="Upload Video"/>
                        </VBox>
                    </graphic>
                </Button>

                <Button onAction="#handleSyncFavourites" 
                        style="-fx-background-color: #7E8CFF; -fx-text-fill: white; -fx-background-radius: 15; -fx-padding: 15 25; -fx-font-weight: bold; -fx-cursor: hand;">
                    <graphic>
                        <VBox alignment="CENTER" spacing="5">
                            <Label text="⭐" style="-fx-font-size: 24;"/>
                            <Label text="Sync Favourites"/>
                        </VBox>
                    </graphic>
                </Button>
            </HBox>
            
            <Hyperlink text="or Select Photos Manually" onAction="#handleSelectPhotos" style="-fx-text-fill: #8892B0; -fx-font-size: 12;"/>
        </VBox>

        <!-- Preview Player (Initially Hidden) -->
        <VBox fx:id="videoPlayerContainer" visible="false" spacing="15" alignment="CENTER">
            <StackPane fx:id="videoPreviewStack" style="-fx-background-color: black; -fx-background-radius: 12; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.2), 15, 0, 0, 5);">
                <ImageView fx:id="videoPreviewImage" preserveRatio="true" fitWidth="600" fitHeight="340"/>
                <javafx.scene.media.MediaView fx:id="videoMediaView" fitWidth="600" fitHeight="340" preserveRatio="true" visible="false" managed="false"/>
                <Label fx:id="videoOverlayLabel" text="" wrapText="true" alignment="CENTER" textAlignment="CENTER"
                       style="-fx-text-fill: white; -fx-font-size: 20; -fx-padding: 15; -fx-font-family: 'Georgia'; -fx-font-style: italic;"/>
            </StackPane>

            <!-- Playback Controls -->
            <VBox spacing="8" style="-fx-padding: 0 40;">
                <Slider fx:id="videoSeekBar" style="-fx-cursor: hand;"/>
                <HBox spacing="25" alignment="CENTER">
                    <Button fx:id="btnSkipPrev" text="⏮" onAction="#handleSkipPrevious" 
                            style="-fx-background-color: transparent; -fx-font-size: 20; -fx-text-fill: #1A1D2E; -fx-cursor: hand;"/>
                    <Button fx:id="btnVideoPlay" text="▶" onAction="#handleVideoPlayPause"
                            style="-fx-background-color: #4F5BD5; -fx-text-fill: white; -fx-font-size: 18; -fx-min-width: 44; -fx-min-height: 44; -fx-background-radius: 22; -fx-cursor: hand;"/>
                    <Button fx:id="btnSkipNext" text="⏭" onAction="#handleSkipNext" 
                            style="-fx-background-color: transparent; -fx-font-size: 20; -fx-text-fill: #1A1D2E; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </StackPane>

    <!-- Functional Panel (Right) -->
    <VBox spacing="15" prefWidth="320" minWidth="320" maxWidth="320"
          style="-fx-background-color: #FFFFFF; -fx-border-color: #D0E8FF; -fx-border-width: 0 0 0 1; -fx-padding: 20; -fx-background-radius: 40 0 0 40; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif;">
        
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="🎬 Video Lab" style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
        </HBox>

        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background: transparent; -fx-background-color: transparent; -fx-border-color: transparent;">
            <VBox spacing="20">
                <!-- Compilation Section -->
                    <VBox spacing="12" style="-fx-background-color: #F8FAFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #D9C8FF; -fx-border-radius: 15;">
                        <Label text="COMPILATION" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                        
                        <VBox spacing="10" fx:id="synthesisControls" VBox.vgrow="ALWAYS">
                            <Label text="Individual Photo Durations" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <ScrollPane fitToWidth="true" minHeight="100" maxHeight="200" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                                <VBox fx:id="photoDurationList" spacing="8" style="-fx-padding: 5;"/>
                            </ScrollPane>
                            <Label text="Enter duration in seconds for each image." style="-fx-font-size: 10; -fx-text-fill: #8892B0;" wrapText="true"/>
                        </VBox>

                    <VBox fx:id="trimControls" spacing="12" visible="false" managed="false" style="-fx-background-color: #FFF4E5; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #FFD29D; -fx-border-radius: 15;">
                        <Label text="🎬 VIDEO TRIMMING" style="-fx-font-family: 'Poppins SemiBold'; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #E67E22;"/>
                        <VBox spacing="8">
                            <Label text="Trim Amount (seconds)" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <TextField fx:id="videoTrimInput" promptText="e.g. 2.5" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-padding: 5;"/>
                        </VBox>
                        <HBox spacing="10" alignment="CENTER">
                            <Button fx:id="btnTrimFront" text="Cut Front" onAction="#handleTrimFront" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                            <Button fx:id="btnTrimBack" text="Cut Back" onAction="#handleTrimBack" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                                    style="-fx-background-color: #F39C12; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-cursor: hand;"/>
                        </HBox>
                        <Label text="Enter seconds to remove from start or end." style="-fx-font-size: 9; -fx-text-fill: #A04000;" wrapText="true"/>
                    </VBox>
                </VBox>

                <!-- Overlay Section -->
                <VBox spacing="12" style="-fx-background-color: #F8FAFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #C8E8FF; -fx-border-radius: 15;">
                    <Label text="CONTENT OVERLAY" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                    
                    <VBox spacing="5">
                        <Label text="Poem / Text Content" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                        <TextArea fx:id="videoOverlayText" promptText="Enter your poem or text here..." prefHeight="80" wrapText="true"
                                  style="-fx-background-color: white; -fx-background-radius: 10; -fx-border-color: #E2E8F0; -fx-border-radius: 10; -fx-padding: 5; -fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif;"/>
                    </VBox>
                    
                    <VBox spacing="10">
                        <VBox spacing="5">
                            <Label text="Font Family" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <ComboBox fx:id="videoFontCombo" maxWidth="Infinity" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"/>
                        </VBox>
                        
                        <VBox spacing="5">
                            <Label text="Text Color" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <ColorPicker fx:id="videoTextColorPicker" maxWidth="Infinity" style="-fx-background-color: white; -fx-background-radius: 8; -fx-border-color: #E2E8F0; -fx-border-radius: 8;"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Transparency" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <Slider fx:id="videoOpacitySlider" min="0" max="1" value="1" blockIncrement="0.1" style="-fx-cursor: hand;"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="X Position" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <Slider fx:id="videoTextXSlider" min="-300" max="300" value="0" style="-fx-cursor: hand;"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Y Position" style="-fx-font-size: 11; -fx-font-weight: bold; -fx-text-fill: #4A4A4A;"/>
                            <Slider fx:id="videoTextYSlider" min="-150" max="150" value="0" style="-fx-cursor: hand;"/>
                        </VBox>
                    </VBox>
                </VBox>

                <!-- Graphical Elements -->
                <VBox spacing="12" style="-fx-background-color: #F8FAFF; -fx-padding: 15; -fx-background-radius: 15; -fx-border-color: #FFE8C8; -fx-border-radius: 15;">
                    <Label text="GRAPHICS" style="-fx-font-family: 'Poppins SemiBold', 'Poppins', 'Segoe UI', sans-serif; -fx-font-weight: bold; -fx-font-size: 10; -fx-text-fill: #7A7A7A;"/>
                    <ComboBox fx:id="videoGraphicsCombo" promptText="Select Element" maxWidth="Infinity" style="-fx-font-family: 'Poppins Regular', 'Poppins', 'Segoe UI', sans-serif;">
                        <items>
                            <FXCollections fx:factory="observableArrayList">
                                <String fx:value="None" />
                                <String fx:value="Heart Stickers" />
                                <String fx:value="Star Explosion" />
                                <String fx:value="Birthday Party" />
                                <String fx:value="Retro Film" />
                                <String fx:value="Classic Vignette" />
                                <String fx:value="Golden Borders" />
                                <String fx:value="White Borders" />
                            </FXCollections>
                        </items>
                    </ComboBox>
                </VBox>

                <!-- Export -->
                <Button text="💾 Render &amp; Save Video" maxWidth="Infinity" minHeight="50" onAction="#handleRenderSave"
                        style="-fx-background-color: #4F5BD5; -fx-text-fill: white; -fx-background-radius: 12; -fx-font-weight: bold; -fx-font-family: 'Poppins Medium', 'Poppins', 'Segoe UI', sans-serif; -fx-cursor: hand;"/>
            </VBox>
        </ScrollPane>
    </VBox>
</HBox>
